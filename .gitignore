# Rust
/target/
**/target/
# Isolated bench build target (CARGO_TARGET_DIR=target-bench) — build output, never source
/target-bench/
**/target-bench/
**/*.rs.bk
*.pdb

# Tauri generated schemas (build artifacts)
**/gen/schemas/

# mdBook build output (regenerated by docs CI)
/docs/book/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Memory data
veld_data/
shodh-internal/
shodh_memory_data/
*.db
*.rocksdb/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Config (keep example, ignore actual)
veld_config.json
.env
!.env.example

# Claude settings. .claude/ stays ignored; the few tracked files under it were added with -f.
# settings.json is per-machine (permissions, local ports): copy .claude/settings.json.example to start.
.claude/
.claude/settings.json

# Internal documentation (keep local only)
COGNITIVE_ARCHITECTURE.md
*_ARCHITECTURE.md
literature/
literature/

# Paper (not for public release)
paper/

# Local-only legacy collateral
/veld-internal/
/bhashini-authorization-letter.html
/bhashini_letter.pdf
/veld_IITD.odt
/veld_IITD.pdf
/seeds/overlook-*.json

# Third-party binaries, CI logs and one-off patch artefacts
/mcp-publisher.exe
/mcp-publisher.tar.gz
/job_log.txt
/full_log.txt
/macos_log.txt
/apply_layers.py
*.rs.patch

# ONNX Runtime binaries (downloaded per-platform during CI wheel builds)
python/veld/lib/*.dll
python/veld/lib/*.so
python/veld/lib/*.dylib
!python/veld/lib/__init__.py

# Model files (downloaded during CI wheel builds)
python/veld/models/minilm-l6/*.onnx
python/veld/models/minilm-l6/*.json
python/veld/models/bert-tiny-ner/*.onnx
python/veld/models/bert-tiny-ner/*.json
experiments/

# Node.js
node_modules/
bun.lock
package-lock.json
yarn.lock

# Coverage
coverage/
.coverage
*.lcov
htmlcov/

# Temp/test directories
.venv/
test_*/
release-test/
temp_*/

# Credentials (never commit)
.mcpregistry_*
*.token

# Windows artifacts
nul
.vercel

# Build number (auto-incremented per machine, see build.rs)
.build_number

# Local/temp files
graph_temp.json
pitch-deck-stata.md
veld-market.csv
benchmarks/locomo_test2.json
seps/mcp-sep-mif.md
plans/

# Veld agent-session marker files (written by SessionStart hook, see hooks/README.md)
.veld-agent-session.*

# Benchmark results (data, not source)
benchmarks/locomo_*.json
benchmarks/*_results.json
benchmarks/debug_*.json
bench_data_locomo/
locomo_results.json

# Canonical bench/scratch OUTPUT dir — all bench data, stores, and result files
# are disposable and must land here (or under target/), never in the repo root.
# Convention: builds → CARGO_TARGET_DIR=target-bench; data/results → bench-output/.
bench-output/
**/bench-output/
# Scratch / demo server stores (e.g. the monitor multi-instance demo)
**/*-scratch-store/
**/demo-*-store/
bench_data_*/

# Evaluations directory — eval result snapshots + corpus data are derived,
# not source. Includes alignment TOMLs/scripts; re-add with `git add -f` if
# you need to track any specific file.
evaluations/

# Swift build output of the Touch ID helper
/packaging/macos/veld-enclave/.build

# Generated terminal captures; regenerate with scripts/screenshots/shoot.mjs
scripts/screenshots/out/
scripts/screenshots/*.log
