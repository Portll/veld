{
  "$schema": "https://claude.ai/settings-schema.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run $VELD_HOOKS_DIR/memory-hook.ts SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run $VELD_HOOKS_DIR/memory-hook.ts UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Read|Grep|Glob|WebFetch|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $VELD_HOOKS_DIR/memory-hook.ts PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Read|Grep|Glob|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $VELD_HOOKS_DIR/memory-hook.ts PostToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $VELD_HOOKS_DIR/memory-hook.ts PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bun run $VELD_HOOKS_DIR/memory-hook.ts PostToolUseFailure",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run $VELD_HOOKS_DIR/memory-hook.ts SubagentStop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run $VELD_HOOKS_DIR/memory-hook.ts SessionEnd",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
