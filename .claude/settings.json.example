{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__veld-memory"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bun run hooks/statusline.ts http://127.0.0.1:3030,http://127.0.0.1:3031",
    "padding": 0
  },
  "mcpServers": {
    "veld-memory": {
      "command": "bun",
      "args": ["run", "mcp-server/index.ts"],
      "env": {
        "VELD_API_URL": "http://127.0.0.1:3030",
        "VELD_USER_ID": "claude-code",
        "VELD_STREAM": "true",
        "VELD_PROACTIVE": "true"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/memory-hook.ts SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/memory-hook.ts UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Read|Grep|Glob|WebFetch|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/memory-hook.ts PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Read|Grep|Glob|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/memory-hook.ts PostToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/memory-hook.ts PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/memory-hook.ts PostToolUseFailure",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/memory-hook.ts SubagentStop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run hooks/memory-hook.ts SessionEnd",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
